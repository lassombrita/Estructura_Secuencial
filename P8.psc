Algoritmo IntercambioPalabras
    Definir A, B, aux Como Cadena
	
    Escribir "Ingrese la primera palabra (A): "
    Leer A
	
    Escribir "Ingrese la segunda palabra (B): "
    Leer B
	
    aux <- A
    A <- B
    B <- aux
	
    Escribir "Ahora A es: ", A
    Escribir "Ahora B es: ", B
FinAlgoritmo
