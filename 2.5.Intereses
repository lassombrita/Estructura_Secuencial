Algoritmo Intereses
    Definir capital, tasa, tiempo, interes Como Real
	
    Escribir "Ingrese el capital inicial: "
    Leer capital
	
    Escribir "Ingrese la tasa de interés (%): "
    Leer tasa
	
    Escribir "Ingrese el tiempo en años: "
    Leer tiempo
	
    interes <- capital * tasa/100 * tiempo
	
    Escribir "El interés simple es: ", interes
FinAlgoritmo
